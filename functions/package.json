{
  "name": "meram-functions",
  "description": "Cloud Functions backend for Məram ERP — Gemini proxy, user account management, server-side AI quota.",
  "engines": {
    "node": "20"
  },
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "serve": "firebase emulators:start --only functions,database,auth",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/",
    "backfill-claims": "node scripts/backfill-claims.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  }
}
